<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane
        xmlns="http://javafx.com/javafx/17"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.hust.logistics.clean.presentation.gui.MainView"
        prefWidth="1100"
        prefHeight="750"
        stylesheets="@style.css">

    <!-- SIDEBAR -->
    <left>
        <VBox prefWidth="240"
              spacing="15"
              styleClass="sidebar">

            <padding>
                <Insets top="25" left="12" right="12" bottom="25"/>
            </padding>

            <Pane prefHeight="0.2"/>

            <Label text="LOGISTICS AI (FXML)"
                   styleClass="logo-label"/>

            <Pane prefHeight="0.2"/>
            
            <Separator/>

            <Pane prefHeight="0.2"/>

            <Button fx:id="btnTask1"
                    text="💛  1. Xu hướng tâm lý"
                    onAction="#onTaskSelected"
                    maxWidth="Infinity"
                    styleClass="menu-btn"/>

            <Button fx:id="btnTask2"
                    text="📋  2. Đánh giá thiệt hại"
                    onAction="#onTaskSelected"
                    maxWidth="Infinity"
                    styleClass="menu-btn"/>

            <Button fx:id="btnTask3"
                    text="🤝  3. Hài lòng cứu trợ"
                    onAction="#onTaskSelected"
                    maxWidth="Infinity"
                    styleClass="menu-btn"/>

            <Button fx:id="btnTask4"
                    text="📈  4. Theo dõi xu hướng"
                    onAction="#onTaskSelected"
                    maxWidth="Infinity"
                    styleClass="menu-btn"/>
            
            <Separator/>

            <Pane VBox.vgrow="ALWAYS"/>
        </VBox>
    </left>

    <!-- MAIN CONTENT -->
    <center>

        <VBox spacing="15">

            <padding>
                <Insets top="20" left="20" right="20" bottom="20"/>
            </padding>

            <!-- FILTER BAR -->
            <HBox spacing="30"
                  alignment="CENTER_LEFT"
                  styleClass="top-card">

                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="Từ khóa:"/>
                    <StackPane maxWidth="400">
                        <TextField fx:id="keywordsField"
                                   prefWidth="380"
                                   promptText="bão Yagi, lũ lụt, ..."/>
                        <Button text="x"
                                onAction="#clearKeyword"
                                StackPane.alignment="CENTER_RIGHT"
                                style="
                                    -fx-background-color: transparent;
                                    -fx-cursor: hand;
                                    -fx-font-size: 14px;
                                    "/>
                    </StackPane>
                </VBox>

                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="Từ ngày:"/>
                    <DatePicker fx:id="startDatePicker"
                                prefWidth="320"
                                style="
                                    -fx-cursor: hand;
                                "/>
                </VBox>

                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="Đến ngày:"/>
                    <DatePicker fx:id="endDatePicker"
                                prefWidth="320"
                                style="
                                    -fx-cursor: hand;
                                "/>
                </VBox>

                <Button fx:id="btnRun"
                        text="CHẠY PHÂN TÍCH"
                        onAction="#handleRunAnalysis"
                        styleClass="run-button"/>
            </HBox>

            <!-- REPORT AREA -->
            <StackPane fx:id="displayArea"
                       VBox.vgrow="ALWAYS"
                       styleClass="report-card">

                <VBox alignment="TOP_CENTER"
                      spacing="15">

                    <padding>
                        <Insets top="30"/>
                    </padding>

                    <Label text="BÁO CÁO PHÂN TÍCH HỆ THỐNG"
                           styleClass="report-title"/>

                    <Label text="Nhiệm vụ: Chọn chức năng bên trái"
                           styleClass="report-subtitle"/>

                    <Separator prefWidth="600"/>

                    <Label fx:id="placeholderLabel"
                           text="Kết quả phân tích AI sẽ hiển thị tại đây"
                           styleClass="placeholder"/>

                    <ProgressIndicator fx:id="progressIndicator"
                                       visible="false"/>
                </VBox>

            </StackPane>

            <!-- STATUS -->
            <HBox>

                <Label fx:id="statusLabel"
                       text="Sẵn sàng"
                       styleClass="status-label"/>

            </HBox>

        </VBox>

    </center>

</BorderPane>